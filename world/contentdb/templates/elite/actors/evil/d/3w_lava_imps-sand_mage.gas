[t:template,n:3W_sand_mage_base]
{
	specializes = 3W_base_swamp_witch;

	category_name = "3W_evil_d";
	doc = "3W_sand_mage";
	[actor]
	{
		[skills]
		{
			strength = 		29.1, 0;
			intelligence = 	17.7, 0;
			dexterity = 	26.8, 0;
			combat_magic = 	105, 0;
		}
	}
	[aspect]
	{
		experience_value = 4380000;
		life = 2140.1;
		max_life = 2140.1;
		mana = 42.9;
		max_mana = 42.9;
		//model = m_c_edm_li_pos_2;
		//[textures] { 0=b_c_edm_li-06; }
		textures:0 = b_c_edm_sw-02;
		scale_base = 0.7;
	}
	[attack]
	{
		attack_range = 0.5;
		damage_max = 442.5;
		damage_min = 313.8;
		damage_bonus_min_cmagic = 200;
		damage_bonus_max_cmagic = 281;
	}
	[common] { screen_name="Sand Witch"; }
	[defend] { defense=984.2; }
   	[inventory]
	{
    	selected_active_location = il_active_primary_spell;
		[other] { il_active_primary_spell=spell_sand_mage_blast; }
    	[pcontent]
		{
   			[oneof*]
			{
				[oneof*]
				{
					chance = 0.25;
					il_main = #*/195-285;
               		il_main = #nmagic/114-139;
               		il_main = #cmagic/114-139;
				}
				[gold*]
				{
					chance = 0.125;
                    max = 604334;
					min = 520540;
				}
			}
		}
	}
	[mind]
	{
		jat_brain					 = world\ai\jobs\common\brain_hero.skrit
			?actor_creates_own_party = true
			&party_template			 = "party_sand_mage";

		jat_fidget					 = world\ai\jobs\common\job_fidget.skrit;

		actor_weapon_preference			= WP_MAGIC;
		actor_auto_switches_to_magic	= true;
		actor_auto_switches_to_karate	= false;
		actor_auto_switches_to_melee	= false;

		melee_engage_range = 14;
		personal_space_range = 0.7;
		ranged_engage_range = 14.0;
		sight_range = 14;

		jat_die = world\ai\jobs\common\job_die.skrit;
	}
}
[t:template,n:3W_sand_mage]
{
	category_name = "3W_evil_d";
	doc = "3W_sand mage";
	specializes = 3W_sand_mage_base;
}

[t:template,n:3W_sand_mage_reveal]
{
	category_name = "3W_evil_d";
	doc = "3W_revealing sand mage";
	specializes = 3W_sand_mage_base;
	[mind]
	{
		jat_brain	= world\ai\jobs\common\brain_hero.skrit;
		jat_startup = world\ai\jobs\common\job_startup_reveal.skrit
			?invisible = true;
		sight_origin_height = 1;
		actor_auto_fidgets = false;
	}
	[common]
	{
		[template_triggers]
		{
			[*]
			{
				single_shot = true;
				action* = call_sfx_script("sand_mage_reveal");
				condition* = receive_world_message("we_enemy_spotted");
			}
		}
	}
}
