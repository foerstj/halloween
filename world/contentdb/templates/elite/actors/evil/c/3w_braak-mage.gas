[t:template,n:3W_braak_magic_base]
{
	category_name = "3W_evil_c";
	doc = "3W_braak, magic";
	specializes = 3W_base_braak;
	[common] { screen_name="Ice Braak"; }
	[actor]
	{
		[skills]
		{
			strength =  38.7, 0;
			intelligence =  17.2, 0;
			dexterity =  28.3, 0;
            nature_magic =  95,  0;
		}
	}
	[aspect]
	{
		experience_value = 917150;
		life = 1233;
        max_life = 1233;
		mana = 360;
		max_mana = 360;
        scale_base = 0.7;
        [textures] { 0 = b_c_ecm_bk-02; }
        [voice]
		{
			[cast]			{ * = s_e_attack_braak_mage; }
			[die]			{ priority = high; * = s_e_die_braak; }
			[hit_glance]	{ priority = low; * = s_e_hit_braak; }
		}
	}
	[attack]
	{
		attack_range = 0.5;
		damage_max = 277.2;
		damage_min = 194.4;
		damage_bonus_min_cmagic = 137;
		damage_bonus_max_cmagic = 185;
	}
	[common] { screen_name="Braak Mage"; }
	[defend] { defense=405; }
	[inventory]
	{
		selected_active_location = il_active_primary_spell;
		[other] { il_active_primary_spell=spell_braak_iceblast; }
		[pcontent]
		{
			[oneof*]
			{
				[oneof*]
				{
				   chance = 0.05;
				   il_main = potion_health_super;
				   il_main = potion_mana_super;
				}
				[all*]
				{
       				chance = 0.02;
	                il_main = #spell/72-126;
				}
				[oneof*]
				{
					chance = 0.25;
					il_main = #*/213-272;
					il_main = #armor/117-594;
                    il_main = #body,ro/317-594;
	                il_main = #weapon/213-272;
                }
                [oneof*]
				{
	                   chance = 0.004;
	                   il_main = #weapon/-rare(1)/247-323;
	                   il_main = #armor/-rare(1)/468-819;
                       il_main = #*/-rare(1)/247-323;
                }
				[oneof*]
				{
                       chance = 0.002;
	                   il_main = #weapon/-unique(2)/247-323;
	                   il_main = #armor/-unique(2)/468-819;
                       il_main = #*/-unique(2)/247-323;
				}
				[gold*]
				{
					chance = 0.125;
					max = 316782;
					min = 189638;
				}
			}
		}
	}
	[mind]
	{
		actor_weapon_preference			= WP_MAGIC;
		actor_auto_switches_to_magic	= true;
		actor_auto_switches_to_karate	= false;
		actor_auto_switches_to_melee	= false;
		jat_fidget						= world\ai\jobs\common\job_fidget.skrit
			?social							= 0.5
			&meander						= false
			&still							= false;
	}
}
[t:template,n:3W_braak_magic]
{
	category_name = "3W_evil_c";
	doc = "3W_braak magic";
	specializes = 3W_braak_magic_base;
}

[t:template,n:3W_braak_magic_reveal]
{
	category_name = "3W_evil_c";
	doc = "3W_revealing braak magic";
	specializes = 3W_braak_magic_base;
	[mind]
	{
		jat_startup = world\ai\jobs\common\job_startup_reveal.skrit
			?invisible = true;
		sight_origin_height = 1;
		actor_auto_fidgets = false;
	}
	[common]
	{
		[template_triggers]
		{
			[*]
			{
				single_shot = true;
				action* = call_sfx_script("braak_magic_reveal");
				condition* = receive_world_message("we_enemy_spotted");
			}
		}
	}
}
[t:template,n:3W_braak_magic_reveal_act]
{
	category_name = "3W_evil_c";
	doc = "3W_revealing braak magic activate";
	specializes = 3W_braak_magic_base;
	[mind]
	{
		jat_startup = world\ai\jobs\common\job_startup_reveal.skrit
			?invisible = true
			&activate = true;
		sight_origin_height = 1;
		actor_auto_fidgets = false;
	}
	[common]
	{
		[template_triggers]
		{
			[*]
			{
				single_shot = true;
				action* = call_sfx_script("braak_magic_reveal");
				condition* = receive_world_message("we_req_activate");
			}
		}
	}
}
