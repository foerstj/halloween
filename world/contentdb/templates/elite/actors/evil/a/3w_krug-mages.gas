[t:template,n:3W_krug_shaman_base]
{
	specializes = 3W_base_swamp_witch;

	  category_name = "3W_evil_a";
	  doc = "3W_krug shaman base";
	[actor]
	{
		  race = krug;
	}
	[common]
	{
		  membership = krug, monster;
	}
	[inventory]
	{
		  selected_active_location = il_active_primary_spell;
		[other]
		{
			  il_active_primary_spell   = spell_fireshot;
			  il_active_secondary_spell = spell_resurrect_monster;
		}
	}

	[guts_manager]
	{
		effect_name = melee_hit_2;
	}
	[water_effects] {}

	[mind]
	{
		com_channels						= dyn_party, krug;
		com_range							= 8.0;
		jat_brain							 = world\ai\jobs\common\brain_hero.skrit
			?actor_creates_own_party		 = true
			&party_template					 = "party_krug_shaman";
		jat_die 						= world\ai\jobs\common\job_die.skrit;
	}
}

[t:template,n:3W_krug_shaman]
{
	  category_name = "3W_evil_a";
	  doc = "3W_krug shaman";
	  specializes = 3W_krug_shaman_base;
	[actor]
	{
		[skills]
		{
			  combat_magic = 90, 0;
			  dexterity = 12.9, 0;
			  intelligence = 14.2, 0;
			  melee = 91, 0;
			  strength = 47.5, 0;
		}
	}
	[aspect]
	{
		  experience_value = 716848;
		  life = 486.5;
		  mana = 3604.5;
		  max_life = 486.5;
		  max_mana = 3604.5;
	}
	[attack]
	{
		  damage_max = 342.4;
		  damage_min = 306.4;
		damage_bonus_min_cmagic = 264;
		damage_bonus_max_cmagic = 300;
	}
	[common]
	{
		  screen_name = "Witch";
	}
	[defend]
	{
		  defense = 908.3;
	}
	[inventory]
	{
		  selected_active_location = il_active_primary_spell;
		[other]
		{
			  il_active_primary_spell   = spell_witch_fireshot;
			  il_active_secondary_spell = spell_resurrect_monster;
		}
		[pcontent]
		{
			[oneof*]
			{
				[gold*]
				{
					  chance = 0.3;
					  max = 205112;
					  min = 186697;
				}
				[oneof*]
				{
					  il_main = potion_mana_super;
					  il_main = potion_health_super;
					  max = 2;
					  min = 1;
                      chance = 0.3;
				}
				[all*]
				{
					  chance = 0.3;
					  il_main = spell_fireshot;
				}
				[oneof*]
				{
					  chance = 0.1;
					  il_main = book_glb_magic_01;
                      il_main = #body,ro/390-480;
				}
             }
		}
	}
}

[t:template,n:3W_krug_shaman_boss_01]
{
	  category_name = "3W_evil_a";
	  doc = "3W_krug shaman boss 01";
	  specializes = 3W_krug_shaman_base;
	[actor]
	{
		[skills]
		{
			  combat_magic = 90, 0;
			  dexterity = 18.3, 0;
			  intelligence = 17.4, 0;
			  melee = 88, 0;
			  strength = 51.7, 0;
		}
	}
	[aspect]
	{
		//textures:0 = b_c_eam_ks-02;
		  experience_value = 917150;
		  life = 800.8;
		  mana = 9100;
		  max_life = 800.8;
		  max_mana = 9100;
	      selection_indicator_scale = 1.2;
	}
	[attack]
	{
		  damage_max = 240.2;
		  damage_min = 131;
		damage_bonus_min_cmagic = 204;
		damage_bonus_max_cmagic = 305;
	}
	[common]
	{
		  screen_name = "Huska the Witch";
		  membership = krug,monster,immune_charm,immune_control,immune_freeze,immune_polymorph,immune_align_change,immune_explode;
		[template_triggers]
		{
			[*]
			{
				condition* = receive_world_message("WE_ENTERED_WORLD");
				single_shot = true;
				no_trig_bits=true;
				action* = call_sfx_script("unique_ray_yellow(sgx)");

			}

		}

	}
	[defend]
	{
		  defense = 1310.4;
	}
	[inventory]
	{
		  selected_active_location = il_active_primary_spell;
		[other]
		{
			  il_active_primary_spell   = spell_witch_fireshot;
			  il_active_secondary_spell = spell_resurrect_monster;
		}
		[pcontent]
		{
			[oneof*]
			{
				[gold*]
				{
					chance = 0.5;
					max = 1816125;
					min = 1260781;
					min_pile = 10;
					piles = 4 - 6;
				}
				[all*]
				{
					chance = 0.5;
					il_main = #weapon/225-257;
					il_main = #body/528-637;
                    il_main = #body,ro/528-637;
					  max = 2;
					  min = 1;
				}
             }
		}
	}
	[mind]
	{
		jat_brain							 = world\ai\jobs\common\brain_hero.skrit
			?actor_creates_own_party			= true
			&form_party_on_friend_entered_ICZ	= true
			&form_party_on_friend_entered_OCZ	= true
			&party_template						= "party_krug_shaman";
	}
}


