[t:template,n:2W_braak_magic_base]
{
	category_name = "2W_evil_c";
	doc = "2W_braak, magic";
	specializes = 2W_base_swamp_witch;  // EDITED
	[actor]
	{
		[skills]
		{
			strength =  27.3, 0;
			intelligence =  14.4, 0;
			dexterity =  21.2, 0;
            nature_magic =  61,  0;
		}
	}
	[aspect]
	{
		experience_value = 29665;
		life = 809.5;
        max_life = 809.5;
		mana = 236.4;
		max_mana = 236.4;
        scale_base = 0.7;
        [textures] { 0 = b_c_edm_img; }  // EDITED
        //[voice]
		//{
		//	[cast]			{ * = s_e_attack_braak_mage; }
		//	[die]			{ priority = high; * = s_e_die_braak; }
		//	[hit_glance]	{ priority = low; * = s_e_hit_braak; }
		//}
	}
	[attack]
	{
		attack_range = 0.5;
		damage_max = 182;
		damage_min = 127.6;
		damage_bonus_min_cmagic = 84;
		damage_bonus_max_cmagic = 113;
	}
	[common] { screen_name="Snow Witch"; }  // EDITED
	[defend] { defense=265.9; }
	[inventory]
	{
		selected_active_location = il_active_primary_spell;
		[other] { il_active_primary_spell=spell_braak_iceblast; }
		[pcontent]
		{
			[oneof*]
			{
				[oneof*]
				{
				   chance = 0.05;
				   il_main = potion_health_large;
				   il_main = potion_mana_large;
				}
				[all*]
				{
       				chance = 0.02;
	                il_main = #spell/47-83;
				}
				[oneof*]
				{
					chance = 0.25;
					il_main = #*/140-180;
					il_main = #armor/77-390;
	                il_main = #weapon/140-180;
                    il_main = #body,ro/217-390;
                }
                [oneof*]
				{
	                   chance = 0.004;
	                   il_main = #weapon/-rare(1)/163-213;
	                   il_main = #armor/-rare(1)/307-538;
                       il_main = #*/-rare(1)/163-213;
                }
				[oneof*]
				{
                       chance = 0.002;
	                   il_main = #weapon/-unique(2)/163-213;
	                   il_main = #armor/-unique(2)/307-538;
                       il_main = #*/-unique(2)/163-213;
				}
				[gold*]
				{
					chance = 0.125;
					max = 70605;
					min = 42267;
				}
			}
		}
	}
	[mind]
	{
		actor_weapon_preference			= WP_MAGIC;
		actor_auto_switches_to_magic	= true;
		actor_auto_switches_to_karate	= false;
		actor_auto_switches_to_melee	= false;
		jat_fidget						= world\ai\jobs\common\job_fidget.skrit
			?social							= 0.5
			&meander						= false
			&still							= false;
		jat_die 						= world\ai\jobs\common\job_die.skrit;  // ADDED
	}
}
[t:template,n:2W_braak_magic]
{
	category_name = "2W_evil_c";
	doc = "2W_braak magic";
	specializes = 2W_braak_magic_base;
}

[t:template,n:2W_braak_magic_reveal]
{
	category_name = "2W_evil_c";
	doc = "2W_revealing braak magic";
	specializes = 2W_braak_magic_base;
	[mind]
	{
		jat_startup = world\ai\jobs\common\job_startup_reveal.skrit
			?invisible = true;
		sight_origin_height = 1;
		actor_auto_fidgets = false;
	}
	[common]
	{
		[template_triggers]
		{
			[*]
			{
				single_shot = true;
				action* = call_sfx_script("braak_magic_reveal");
				condition* = receive_world_message("we_enemy_spotted");
			}
		}
	}
}
[t:template,n:2W_braak_magic_reveal_act]
{
	category_name = "2W_evil_c";
	doc = "2W_revealing braak magic activate";
	specializes = 2W_braak_magic_base;
	[mind]
	{
		jat_startup = world\ai\jobs\common\job_startup_reveal.skrit
			?invisible = true
			&activate = true;
		sight_origin_height = 1;
		actor_auto_fidgets = false;
	}
	[common]
	{
		[template_triggers]
		{
			[*]
			{
				single_shot = true;
				action* = call_sfx_script("braak_magic_reveal");
				condition* = receive_world_message("we_req_activate");
			}
		}
	}
}
