[t:template,n:2W_sand_mage_base]
{
	category_name = "2W_evil_d";
	doc = "2W_sand_mage";
	specializes = 2W_base_imp;
	[actor]
	{
		[skills]
		{
			strength = 		21.9, 0;
			intelligence = 	15.2, 0;
			dexterity = 	21.1, 0;
			combat_magic = 	72, 0;
		}
	}
	[aspect]
	{
		experience_value = 150000;
		life = 1541.6;
		max_life = 1541.6;
		mana = 30.9;
		max_mana = 30.9;
		model = m_c_edm_li_pos_2;
		[textures] { 0=b_c_edm_li-06; }
	}
	[attack]
	{
		attack_range = 0.5;
		damage_max = 318.8;
		damage_min = 226;
		damage_bonus_min_cmagic = 111;
		damage_bonus_max_cmagic = 156;
	}
	[common] { screen_name="Sand Mage"; }
	[defend] { defense=709; }
   	[inventory]
	{
    	selected_active_location = il_active_primary_spell;
		[other] { il_active_primary_spell=spell_sand_mage_blast; }
    	[pcontent]
		{
   			[oneof*]
			{
				[oneof*]
				{
					chance = 0.25;
					il_main = #*/150-219;
               		il_main = #nmagic/87-106;
               		il_main = #cmagic/87-106;
				}
				[gold*]
				{
					chance = 0.125;
                    max = 187097;
					min = 161155;
				}
			}
		}
	}
	[mind]
	{
		jat_brain					 = world\ai\jobs\common\brain_hero.skrit
			?actor_creates_own_party = true
			&party_template			 = "party_sand_mage";

		jat_fidget					 = world\ai\jobs\common\job_fidget.skrit;

		actor_weapon_preference			= WP_MAGIC;
		actor_auto_switches_to_magic	= true;
		actor_auto_switches_to_karate	= false;
		actor_auto_switches_to_melee	= false;

		melee_engage_range = 14;
		personal_space_range = 0.7;
		ranged_engage_range = 14.0;
		sight_range = 14;
	}
}
[t:template,n:2W_sand_mage]
{
	category_name = "2W_evil_d";
	doc = "2W_sand mage";
	specializes = 2W_sand_mage_base;
}

[t:template,n:2W_sand_mage_reveal]
{
	category_name = "2W_evil_d";
	doc = "2W_revealing sand mage";
	specializes = 2W_sand_mage_base;
	[mind]
	{
		jat_brain	= world\ai\jobs\common\brain_hero.skrit;
		jat_startup = world\ai\jobs\common\job_startup_reveal.skrit
			?invisible = true;
		sight_origin_height = 1;
		actor_auto_fidgets = false;
	}
	[common]
	{
		[template_triggers]
		{
			[*]
			{
				single_shot = true;
				action* = call_sfx_script("sand_mage_reveal");
				condition* = receive_world_message("we_enemy_spotted");
			}
		}
	}
}
